# Vivado block-design generated artifacts (keep .bd/.bxml/.xdc/.xci sources)
Vivado_Project/*.srcs/*/bd/*/hw_handoff/
Vivado_Project/*.srcs/*/bd/*/hdl/
Vivado_Project/*.srcs/*/bd/*/synth/
Vivado_Project/*.srcs/*/bd/*/sim/
Vivado_Project/*.srcs/*/bd/*/ip/*/synth/
Vivado_Project/*.srcs/*/bd/*/ip/*/sim/
Vivado_Project/*.srcs/*/bd/*/ipshared/
Vivado_Project/*.srcs/*/bd/*/ui/

# Vivado HLS / Vitis HLS generated projects and build output
vision_filter_HLS/.apc/
vision_filter_HLS/.settings/
vision_filter_HLS/solution*/
vision_filter_HLS/*.log
vision_filter_HLS/*.jou

# Python caches and local environments
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Local editor and operating-system files
.vscode/
.idea/
