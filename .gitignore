# Vivado generated projects and build output
Vivado_Project/**/.Xil/
Vivado_Project/*.cache/
Vivado_Project/*.runs/
Vivado_Project/*.sim/
Vivado_Project/*.hw/
Vivado_Project/*.gen/
Vivado_Project/*ip_user_files/
Vivado_Project/*.jou
Vivado_Project/*.log
Vivado_Project/*.str
Vivado_Project/*.pb
Vivado_Project/*.wdb
Vivado_Project/*.wcfg
Vivado_Project/*.dcp
Vivado_Project/*.bit
Vivado_Project/*.ltx
Vivado_Project/*.rpt
Vivado_Project/*.rpx
Vivado_Project/*.vdi
Vivado_Project/usage_statistics_webtalk.*
